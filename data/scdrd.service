[Unit]
Description=SCDR process scheduling daemon
# Both renice the same processes; running two priority daemons makes them fight.
Conflicts=ananicy-cpp.service com.system76.Scheduler.service system76-scheduler.service
After=dbus.service

[Service]
Type=dbus
BusName=org.scdr.Daemon1
ExecStart=/usr/bin/scdrd
# Also after a crash: devbox mustn't keep favouring the last focused app.
ExecStopPost=/usr/bin/rm -f /run/scdr/devbox-hints
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
# Exit 3: another priority daemon runs (see Conflicts=); retrying won't help.
RestartPreventExitStatus=3
# Pause and role switches persist here (runtime.json).
StateDirectory=scdr
# What scdr has changed (ledger.json), so a restart after a crash can undo
# it. Kept until reboot, which resets everything it records anyway.
RuntimeDirectory=scdr
RuntimeDirectoryPreserve=yes
RestartSec=2s

# Only what scdrd needs: change other processes' scheduling (SYS_NICE),
# listen to process events (NET_ADMIN), write their oom_score_adj
# (SYS_RESOURCE, DAC_OVERRIDE) and read their exe links (SYS_PTRACE).
# SETUID/SETGID: run `systemctl --user` as the unit's user to set its
# weights; without them that goes through --machine and a PAM login session
# per call.
CapabilityBoundingSet=CAP_SYS_NICE CAP_NET_ADMIN CAP_SYS_RESOURCE CAP_DAC_OVERRIDE CAP_SYS_PTRACE CAP_SETUID CAP_SETGID
NoNewPrivileges=yes
ProtectSystem=strict
# read-only, not yes: yes also hides /run/user, where the user managers'
# sockets are (connecting to one is not a write).
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
# Needs /proc/sys/kernel/sched_autogroup_enabled.
ProtectKernelTunables=no
# cgroupfs stays read-only (systemd sets unit weights for us); iocost is
# the one file scdrd writes itself, and only with [system] iocost = true.
ProtectControlGroups=yes
ReadWritePaths=-/sys/fs/cgroup/io.cost.qos
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
