<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SCDR</vendor>
  <vendor_url>https://github.com/asafelobotomy/scdr</vendor_url>

  <!-- Pause/resume scdrd, switch its roles on or off, reload its config.
       Reading its state needs no authorization. -->
  <action id="org.scdr.control">
    <description>Control the SCDR scheduling daemon</description>
    <message>Authentication is required to change how SCDR schedules processes</message>
    <icon_name>preferences-system-performance</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
