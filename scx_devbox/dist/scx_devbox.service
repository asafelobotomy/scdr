[Unit]
Description=scx_devbox sched_ext scheduler (low-end dev boxes with LLM agents)
Documentation=file://@DOCDIR@/README.md
# Only one sched_ext scheduler can run; don't fight scx_loader-started ones.
Conflicts=scx.service
After=scdrd.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
ExecStart=@BINDIR@/scx_devbox
# If the kernel ejects the scheduler (stall, error) the loader exits 1 and the
# system is already back on EEVDF; retry a few times, then stay on EEVDF.
Restart=on-failure
RestartSec=5
Nice=-5
# /run/scx_devbox/api tells scdr this loader takes focus hints, which scdr
# writes to /run/scdr/devbox-hints (see src/hints.h).
RuntimeDirectory=scx_devbox
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
