# Maintainer: SCDR contributors
#
# Builds from this source tree: `cd packaging/arch && makepkg -si`.
# For the AUR, replace _root with a source=() git URL and add checksums.

pkgname=scdr
pkgver=0.2.0
pkgrel=1
pkgdesc="Process scheduling and priority daemon for EEVDF and sched_ext kernels"
arch=('x86_64' 'aarch64')
url="https://github.com/asafelobotomy/scdr"
license=('MPL-2.0')
install=scdr.install
depends=('libgcc' 'glibc' 'dbus' 'systemd')
makedepends=('cargo')
optdepends=('scx-scheds: sched_ext schedulers ([sched_ext])'
            'scx-tools: scx_loader, which scdr drives ([sched_ext])'
            'pipewire: audio-client role (pw-dump)'
            'gamemode: game role'
            'power-profiles-daemon: per-power-profile roles')

_root="$(realpath "$startdir/../..")"

prepare() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  cd "$_root"
  ./packaging/install.sh "$pkgdir" "$srcdir/target/release"
}
