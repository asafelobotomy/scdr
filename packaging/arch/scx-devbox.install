# shellcheck shell=bash
# Sourced by pacman (no shebang).
post_install() {
  cat <<'MSG'
==> scx_devbox is installed but not running. Either let scdr run it: pick
    "devbox" as a scheduler in [sched_ext] (or on the Scheduling page), and
    scdr starts and stops the unit itself. Or run it by hand with scdr's
    [sched_ext] off: stop any other scheduler first (scxctl stop), then
      systemctl enable --now scx_devbox
    and back to EEVDF with: systemctl disable --now scx_devbox
MSG
}

post_upgrade() {
  if systemctl is-active --quiet scx_devbox; then
    echo "==> Restart scx_devbox to use the new version: systemctl restart scx_devbox"
  fi
}

pre_remove() {
  # Unloading returns the system to EEVDF straight away.
  systemctl stop scx_devbox 2>/dev/null || true
}
